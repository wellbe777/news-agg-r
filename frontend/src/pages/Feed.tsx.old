import React, { useEffect, useState } from "react";
import api from "../api/api";
import { useAuth } from "../context/AuthContext";

interface Article {
  id: number;
  title: string;
  summary: string;
}

const Feed: React.FC = () => {
  const { user, logout } = useAuth();
  const [articles, setArticles] = useState<Article[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchFeed = async () => {
      try {
        const res = await api.get("/news/"); // your Django /api/news/ endpoint
        setArticles(res.data.results || res.data);
      } catch (err) {
        console.error("Error loading feed:", err);
        if ((err as any).response?.status === 401) {  //((err as { response?: { status: number } }).response?.status === 401)
          logout(); // token expired, log out globally
        }
      } finally {
        setLoading(false);
      }
    };

    fetchFeed();
  }, [logout]);

  if (loading) return <div className="p-6 text-gray-500">Loading...</div>;

  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold mb-4">
        Welcome, {user?.username || "Guest"}!
      </h1>

      {articles.length === 0 ? (
        <p>No news articles yet.</p>
      ) : (
        <ul className="space-y-3">
          {articles.map((a) => (
            <li
              key={a.id}
              className="border rounded-lg p-4 hover:bg-gray-50 transition"
            >
              <h2 className="font-semibold">{a.title}</h2>
              <p className="text-gray-600">{a.summary}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
};

export default Feed;
