import React, { useEffect, useState } from "react";
import api from "../api/api";

interface Article {
  id: number;
  title: string;
  source: string;
  category: string;
  summary: string;
}

interface Category { id: number; name: string; }
interface Source { id: number; name: string; }

export default function Feed() {
  // ALL available filters
  const [categories, setCategories] = useState<Category[]>([]);
  const [sources, setSources] = useState<Source[]>([]);

  // Saved interests (permanent user settings)
  const [savedCatIds, setSavedCatIds] = useState<number[]>([]);
  const [savedSrcIds, setSavedSrcIds] = useState<number[]>([]);

  // Custom mode temporary filters
  const [customCatIds, setCustomCatIds] = useState<number[]>([]);
  const [customSrcIds, setCustomSrcIds] = useState<number[]>([]);

  // UI mode toggle
  const [mode, setMode] = useState<"saved" | "custom">("saved");

  // Feed
  const [articles, setArticles] = useState<Article[]>([]);
  const [loading, setLoading] = useState(false);

  // Load filters + user interests
  useEffect(() => {
    const load = async () => {
      const [catRes, srcRes, userRes] = await Promise.all([
        api.get("/categories/"),
        api.get("/sources/"),
        api.get("/user/interests/"),
      ]);

      setCategories(catRes.data);
      setSources(srcRes.data);

      setSavedCatIds(userRes.data.category_ids ?? []);
      setSavedSrcIds(userRes.data.source_ids ?? []);
    };

    load();
  }, []);

  // Fetch Articles
  const loadFeed = async () => {
    setLoading(true);

    const catIds = mode === "saved" ? savedCatIds : customCatIds;
    const srcIds = mode === "saved" ? savedSrcIds : customSrcIds;

    try {
      const res = await api.get("/articles/", {
        params: {
          categories: catIds.join(",") || undefined,
          sources: srcIds.join(",") || undefined,
        },
      });

      setArticles(res.data);
    } catch (e) {
      console.error("Failed to load feed", e);
    }

    setLoading(false);
  };

  // Reload feed when mode or filters change
  useEffect(() => {
    if (savedCatIds.length || savedSrcIds.length) {
      loadFeed();
    }
  }, [mode, savedCatIds, savedSrcIds, customCatIds, customSrcIds]);

  // Toggle custom filters
  const toggleCustomCategory = (id: number) =>
    setCustomCatIds((prev) =>
      prev.includes(id) ? prev.filter((c) => c !== id) : [...prev, id]
    );

  const toggleCustomSource = (id: number) =>
    setCustomSrcIds((prev) =>
      prev.includes(id) ? prev.filter((s) => s !== id) : [...prev, id]
    );

  // Clear only custom filters
  const clearCustomFilters = () => {
    setCustomCatIds([]);
    setCustomSrcIds([]);
  };

  // Active filters displayed in badges
  const activeCatIds = mode === "saved" ? savedCatIds : customCatIds;
  const activeSrcIds = mode === "saved" ? savedSrcIds : customSrcIds;

  const activeCategories = categories.filter((c) =>
    activeCatIds.includes(c.id)
  );
  const activeSources = sources.filter((s) => activeSrcIds.includes(s.id));

  return (
    <div className="max-w-5xl mx-auto p-6">

      {/* Mode Toggle */}
      <div className="flex gap-4 mb-6">
        <button
          onClick={() => setMode("saved")}
          className={`px-4 py-2 rounded-lg font-medium ${
            mode === "saved"
              ? "bg-blue-600 text-white"
              : "bg-gray-200 dark:bg-gray-700 dark:text-gray-300"
          }`}
        >
          Use Saved Interests
        </button>

        <button
          onClick={() => setMode("custom")}
          className={`px-4 py-2 rounded-lg font-medium ${
            mode === "custom"
              ? "bg-blue-600 text-white"
              : "bg-gray-200 dark:bg-gray-700 dark:text-gray-300"
          }`}
        >
          Custom Search Mode
        </button>
      </div>

      {/* Show Filter Badges */}
      {(activeCategories.length > 0 || activeSources.length > 0) && (
        <div className="mb-6">
          <h3 className="font-semibold mb-2">Active Filters:</h3>
          <div className="flex flex-wrap gap-2">

            {activeCategories.map((c) => (
              <span
                key={c.id}
                className="px-3 py-1 bg-blue-100 text-blue-700 dark:bg-blue-800 dark:text-blue-200 rounded-full text-sm flex items-center gap-2"
              >
                {c.name}
                {mode === "custom" && (
                  <button
                    onClick={() => toggleCustomCategory(c.id)}
                    className="font-bold"
                  >
                    ✕
                  </button>
                )}
              </span>
            ))}

            {activeSources.map((s) => (
              <span
                key={s.id}
                className="px-3 py-1 bg-green-100 text-green-700 dark:bg-green-800 dark:text-green-200 rounded-full text-sm flex items-center gap-2"
              >
                {s.name}
                {mode === "custom" && (
                  <button
                    onClick={() => toggleCustomSource(s.id)}
                    className="font-bold"
                  >
                    ✕
                  </button>
                )}
              </span>
            ))}

            {/* “Clear All” only in custom mode */}
            {mode === "custom" && (customCatIds.length > 0 || customSrcIds.length > 0) && (
              <button
                onClick={clearCustomFilters}
                className="px-3 py-1 bg-red-100 text-red-600 hover:bg-red-200 dark:bg-red-800 dark:text-red-200 rounded-full text-sm"
              >
                Clear All
              </button>
            )}
          </div>
        </div>
      )}

      {/* Custom Filter Controls (only in custom mode) */}
      {mode === "custom" && (
        <div className="mb-8">
          <h3 className="font-semibold mb-3">Custom Filters</h3>

          <div className="mb-4">
            <h4 className="text-red-600 dark:text-red-400 mb-2">Categories</h4>
            <div className="flex flex-wrap gap-3">
              {categories.map((cat) => {
                const active = customCatIds.includes(cat.id);
                return (
                  <button
                    key={cat.id}
                    onClick={() => toggleCustomCategory(cat.id)}
                    className={`px-4 py-2 rounded-full border transition ${
                      active
                        ? "bg-blue-600 text-white border-blue-600"
                        : "bg-white text-gray-800 border-gray-300 dark:bg-gray-700 dark:text-gray-200"
                    }`}
                  >
                    {cat.name}
                  </button>
                );
              })}
            </div>
          </div>

          <div className="mb-4">
            <h4 className="text-red-600 dark:text-red-400 mb-2">Sources</h4>
            <div className="flex flex-wrap gap-3">
              {sources.map((src) => {
                const active = customSrcIds.includes(src.id);
                return (
                  <button
                    key={src.id}
                    onClick={() => toggleCustomSource(src.id)}
                    className={`px-4 py-2 rounded-full border transition ${
                      active
                        ? "bg-blue-600 text-white border-blue-600"
                        : "bg-white text-gray-800 border-gray-300 dark:bg-gray-700 dark:text-gray-200"
                    }`}
                  >
                    {src.name}
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* Articles */}
      {loading ? (
        <p className="text-gray-500">Loading feed...</p>
      ) : (
        <div className="space-y-6">
          {articles.length === 0 ? (
            <p className="text-gray-500">No articles found.</p>
          ) : (
            articles.map((a) => (
              <div key={a.id} className="p-4 rounded-lg border dark:border-gray-700">
                <h2 className="text-lg font-semibold">{a.title}</h2>
                <p className="text-sm text-gray-600 dark:text-gray-300">
                  {a.source} • {a.category}
                </p>
                <p className="mt-2 text-gray-800 dark:text-gray-200">{a.summary}</p>
              </div>
            ))
          )}
        </div>
      )}
    </div>
  );
}
