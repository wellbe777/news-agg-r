import { useEffect, useState } from "react";
import api from "../api/api";

interface Source {
  id: number;
  name: string;
  homepage: string;
}

interface Category {
  id: number;
  name: string;
}

interface Article {
  id: number;
  title: string;
  summary: string;
  content: string;
  url: string;
  image_url: string;
  author: string;
  published_at: string;
  source: Source;              
  categories: Category[];      
}

interface PaginatedResponse {
  count: number;
  next: string | null;
  previous: string | null;
  results: Article[];
}

export default function Feed() {
  const [articles, setArticles] = useState<Article[]>([]);
  const [nextUrl, setNextUrl] = useState<string | null>(null);
  const [loading, setLoading] = useState<boolean>(true);

  // Fetch first page of articles
  const fetchArticles = async (url?: string) => {
    try {
      setLoading(true);
      const endpoint = url || "/articles/";
      const response = await api.get<PaginatedResponse>(endpoint);

      // Combine existing + new articles, and deduplicate by URL
      setArticles((prev) => {
        const combined = [...prev, ...response.data.results];
        const unique = combined.filter(
          (a, index, self) => index === self.findIndex((t) => t.url === a.url)
        );
        return unique;
      });

      setNextUrl(response.data.next);
    } catch (error) {
      console.error("Error fetching articles:", error);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchArticles();
  }, []);

  return (
    <div className="container mx-auto px-4 py-6">
      <h1 className="text-3xl font-bold mb-6 text-gray-800">📰 Latest Articles</h1>

      {loading && articles.length === 0 && (
        <p className="text-gray-500 text-center">Loading articles...</p>
      )}

      <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((article) => (
          <div
            key={article.url} // ✅ use URL as unique key
            className="bg-white border rounded-xl shadow-sm hover:shadow-md transition p-4 flex flex-col"
          >
            {article.image_url && (
              <img
                src={article.image_url}
                alt={article.title}
                className="rounded-lg w-full h-48 object-cover mb-3"
              />
            )}
            <h2 className="font-semibold text-lg mb-2 line-clamp-2">{article.title}</h2>
            <p className="text-gray-600 text-sm line-clamp-3 flex-grow">{article.summary}</p>

            <div className="mt-3 text-sm text-gray-500">
              <span className="font-medium">{article.source?.name || "Unknown Source"}</span> •{" "}
              {new Date(article.published_at).toLocaleDateString()}
            </div>

            {Array.isArray(article.categories) && article.categories?.length > 0  && (
              <div className="mt-2 flex flex-wrap gap-1">
                {article.categories.map((cat, idx) => (
                  <span
                    key={cat.id ?? `${article.id}-cat-${idx}`}
                    className="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded-full"
                  >
                    {cat.name || String(cat)}
                  </span>
                ))}
              </div>
            )}

            <a
              href={article.url}
              target="_blank"
              rel="noopener noreferrer"
              className="mt-3 text-blue-600 hover:text-blue-800 text-sm"  // inline-block mt-2 text-blue-600 hover:text-blue-800 font-medium
            >
              Read full article →
            </a>
          </div>
        ))}
      </div>

      {nextUrl && (
        <div className="flex justify-center mt-8">
          <button
            onClick={() => fetchArticles(nextUrl)}
            className="px-6 py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700"
          >
            {loading ? "Loading..." : "Load More"}
          </button>
        </div>
      )}

      {!nextUrl && !loading && (
        <p className="text-center text-gray-400 mt-8">No more articles to load.</p>
      )}
    </div>
  );
}
