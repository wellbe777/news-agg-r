    RegisterSerializer,
    UserSerializer,
    SourceSerializer,
    ArticleSerializer,
    CategorySerializer,
    UserInterestSerializer,
    UserArticleInteractionSerializer,
    TestAddSerializer,
)

class RegisterView(generics.CreateAPIView):
    """Register a new user and immediately issue JWT tokens."""
    serializer_class = RegisterSerializer
    permission_classes = [AllowAny]

    def create(self, request, *args, **kwargs):
        serializer = self.get_serializer(data=request.data)
        serializer.is_valid(raise_exception=True)
        user = serializer.save()

        # ✅ Generate JWT tokens
        refresh = RefreshToken.for_user(user)
        access = str(refresh.access_token)

        data = {
            "user": UserSerializer(user).data,
            "refresh": str(refresh),
            "access": access,
        }
        return Response(data, status=status.HTTP_201_CREATED)


class CurrentUserView(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request):
        """Return current authenticated user info."""
        serializer = UserSerializer(request.user)
        return Response(serializer.data)


class CategoryViewSet(viewsets.ReadOnlyModelViewSet):
    queryset = Category.objects.all().order_by("name")
    serializer_class = CategorySerializer
    pagination_class = None


class SourceViewSet(viewsets.ReadOnlyModelViewSet):
    queryset = Source.objects.prefetch_related("categories").all()
    serializer_class = SourceSerializer
    pagination_class = None

    filter_backends = [DjangoFilterBackend, SearchFilter, OrderingFilter]
    filterset_fields = {
        "active": ["exact"],
        "categories__id": ["exact"],       # filter by category ID
        "categories__slug": ["exact"],     # filter by category slug
    }
    search_fields = ["name", "homepage"]
    ordering_fields = ["name"]


#class ArticleCursorPagination(CursorPagination):
#    ordering = '-created_at'

class ArticleViewSet(viewsets.ReadOnlyModelViewSet):
    serializer_class = ArticleSerializer
    #pagination_class = ArticleCursorPagination  # pagination override
    permission_classes = [AllowAny]
    """
    Article API with:
    - /articles/ (list + pagination)
    - /articles/?search=AI (PostgreSQL FTS with rank + recency)
    - /articles/?ordering=title or -published_at
    """
    ordering_fields = ("published_at", "published_at", "title", "source__name")
    ordering = ("-published_at",)
    queryset = (Article.objects.select_related("source").prefetch_related(Prefetch("categories", queryset=Category.objects.only("id", "name")))
        .order_by("-published_at")
    )

    filter_backends = [DjangoFilterBackend, filters.SearchFilter, filters.OrderingFilter]
    #filterset_fields = ["source", "categories__id"]  # re-validates source based on serializer fields <- causes error
    search_fields = ["title", "summary", "content"]

    def get_queryset(self):
        qs = super().get_queryset()
        params = self.request.query_params

        search_term = params.get("search")
        category_name = params.get("category")
        source_name = params.get("source")

        # 🔍 Full-text search
        if search_term:
            search_query = SearchQuery(search_term, search_type="websearch")
            qs = (
                qs.annotate(
                    rank=SearchRank(
                        F("search_vector"),
                        search_query,
                        weights=[0.3, 0.6, 1.0],
                    )
                )
                .filter(search_vector=search_query)
                .order_by("-rank", "-published_at")
            )
        
        if not qs.exists():
            qs = super().get_queryset().filter(
                Q(title__icontains=search_term) | Q(summary__icontains=search_term)
            )

        # 🏷️ Category filter
        if category_name:
            qs = qs.filter(categories__name__iexact=category_name.strip())

        # 📰 Source filter (case-insensitive)
        if source_name:
            qs = qs.filter(source__name__iexact=source_name.strip())

        # Remove duplicates from category join
        return qs.distinct()


class ArticleListView(generics.ListAPIView):
    serializer_class = ArticleSerializer
    queryset = Article.objects.all().select_related("source").prefetch_related("categories")
    filter_backends = [filters.SearchFilter, filters.OrderingFilter]
    search_fields = ["title", "summary", "categories__name", "source__name"]
    ordering = ["-published_at"]

    def get_queryset(self):
        queryset = super().get_queryset()
        category = self.request.query_params.get("category")
        source = self.request.query_params.get("source")
        if category:
            queryset = queryset.filter(categories__name__iexact=category)
        if source:
            queryset = queryset.filter(source__name__iexact=source)
        return queryset


class NewsListView(generics.ListAPIView):
    queryset = Article.objects.all() #.order_by("-id")
    serializer_class = ArticleSerializer
    permission_classes = [IsAuthenticated]


class UserInterestView(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request):
        # Return all user interests with category and source names
        interests = UserInterest.objects.filter(user=request.user).select_related("category").prefetch_related("sources")
        data = [
            {
                "category": interest.category.name,
                "sources": [s.name for s in interest.sources.all()],
                "weight": interest.weight,
            }
            for interest in interests
        ]
        return Response(data)

    def post(self, request):
        serializer = UserInterestSerializer(data=request.data)
        serializer.is_valid(raise_exception=True)
        category_ids = serializer.validated_data["category_ids"]
        source_ids = serializer.validated_data.get("source_ids", [])

        # Sync user categories
        current_ids = set(UserInterest.objects.filter(user=request.user).values_list("category_id", flat=True))
        new_ids = set([cat.id for cat in category_ids])

        # Add new interests
        for cat_id in new_ids - current_ids:
            UserInterest.objects.create(user=request.user, category_id=cat_id)

        # Remove deselected interests
        UserInterest.objects.filter(user=request.user, category_id__in=current_ids - new_ids).delete()

        # Optionally update sources for all interests
        if source_ids:
            sources = Source.objects.filter(id__in=[s.id for s in source_ids])
            for interest in UserInterest.objects.filter(user=request.user):
                interest.sources.set(sources)

        return Response({"message": "Interests updated successfully."})


class UserArticleInteractionViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = UserArticleInteractionSerializer

    def get_queryset(self):
        return UserArticleInteraction.objects.filter(user=self.request.user)

    def perform_create(self, serializer):
        serializer.save(user=self.request.user)


class RecommendationViewSet(viewsets.ReadOnlyModelViewSet):
    """
    Recommendation API:
    - /recommendations/ → cached recommendations for the user
    - /recommendations/?search=AI → FTS with weighted rank on recommended IDs
    - /recommendations/?ordering=title → optional ordering
    """
    serializer_class = ArticleSerializer
    permission_classes = [IsAuthenticated]
    ordering_fields = ("published_at", "title", "source__name")
    ordering = ("-published_at",)

    def get_queryset(self):
        user = self.request.user
        key = f"recommendations:{user.id}"

        # Get cached IDs or compute fresh ones
        cached_ids = cache.get(key)
        if cached_ids is None:
            articles = compute_recommendations_for_user(user)
            cached_ids = [a.id for a in articles]
            cache.set(key, cached_ids, 3600)  # cache for 1 hour

        qs = Article.objects.filter(id__in=cached_ids).select_related("source").prefetch_related("categories")

        # Apply weighted FTS if ?search= is present
        search_term = self.request.query_params.get("search")
        if search_term:
            search_query = SearchQuery(search_term)
            qs = (
                qs.annotate(
                    rank=SearchRank(F("search_vector"), search_query,weights=[0.3, 0.6, 1.0],)  # title > summary > content
                ).filter(search_vector=search_query).order_by("-rank", "-published_at")
            )
        else:
            qs = qs.order_by(*self.ordering)

        return qs

    @action(detail=False, methods=["post"], url_path="refresh")
    def refresh(self, request):
        """Trigger async recomputation via Celery"""
        compute_recommendations_task.delay(request.user.id)
        return Response({"ok": True, "message": "Recomputing recommendations"})
    
    @action(detail=False, methods=["post"], url_path="refresh_all", permission_classes=[IsAdminUser])
    def refresh_all(self, request):
        """Admin-only: recompute recommendations for all users asynchronously."""
        from .tasks import compute_recommendations_for_all_users
        compute_recommendations_for_all_users.delay()
        return Response({"status": "global refresh started"}, status=status.HTTP_202_ACCEPTED)


class TestCeleryView(APIView):
    """
    Endpoint to queue a Celery test task.
    POST {"x": 2, "y": 3} → returns task_id
    GET /api/test-celery/?task_id=<uuid> → check status/result
    """

    def post(self, request):
        serializer = TestAddSerializer(data=request.data)
        serializer.is_valid(raise_exception=True)
        x = serializer.validated_data["x"]
        y = serializer.validated_data["y"]

        task = test_add.delay(x, y)
        return Response({"task_id": task.id}, status=status.HTTP_202_ACCEPTED)

    def get(self, request):
        from celery.result import AsyncResult
        task_id = request.query_params.get("task_id")
        if not task_id:
            return Response({"error": "task_id required"}, status=status.HTTP_400_BAD_REQUEST)

        result = AsyncResult(task_id)
        data = {
            "task_id": task_id,
            "status": result.status,
            "result": result.result if result.successful() else None,
        }
        return Response(data, status=status.HTTP_200_OK)
