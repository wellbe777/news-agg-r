# backend/news/views.py
from rest_framework import viewsets
from rest_framework.permissions import IsAuthenticated
from rest_framework.decorators import action
from rest_framework.response import Response
from django.db.models import Q
from rest_framework.views import APIView
from django.core.cache import cache
from .tasks import compute_recommendations_for_user
from django_filters.rest_framework import DjangoFilterBackend
from rest_framework.filters import SearchFilter, OrderingFilter

from .models import Source, Article, Category, UserInterest, UserArticleInteraction
from .serializers import (
    SourceSerializer,
    ArticleSerializer,
    CategorySerializer,
    UserInterestSerializer,
    UserArticleInteractionSerializer,
)

class SourceViewSet(viewsets.ReadOnlyModelViewSet):
    queryset = Source.objects.prefetch_related("categories").all()
    serializer_class = SourceSerializer

    filter_backends = [DjangoFilterBackend, SearchFilter, OrderingFilter]
    filterset_fields = {
        "active": ["exact"],
        "categories__id": ["exact"],       # filter by category ID
        "categories__slug": ["exact"],     # filter by category slug
    }
    search_fields = ["name", "homepage"]
    ordering_fields = ["name"]


class ArticleViewSet(viewsets.ReadOnlyModelViewSet):
    queryset = Article.objects.select_related("source").prefetch_related("categories").order_by("-published_at")
    serializer_class = ArticleSerializer
    filterset_fields = {"source": ["exact"]}
    search_fields = ("title", "summary", "content")
    ordering_fields = ("published_at", "source__name")

    def get_queryset(self):
        qs = super().get_queryset()
        category_slug = self.request.query_params.get("category")
        if category_slug:
            qs = qs.filter(categories__slug=category_slug)
        return qs

    @action(detail=False, methods=["get"], url_path="search")
    def search(self, request):
        q = request.query_params.get("q", "")
        qs = self.get_queryset()
        if q:
            qs = qs.filter(Q(title__icontains=q) | Q(summary__icontains=q) | Q(content__icontains=q))
        page = self.paginate_queryset(qs)
        return self.get_paginated_response(self.get_serializer(page, many=True).data)


class CategoryViewSet(viewsets.ReadOnlyModelViewSet):
    queryset = Category.objects.all().order_by("name")
    serializer_class = CategorySerializer


class UserInterestViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = UserInterestSerializer

    def get_queryset(self):
        return UserInterest.objects.filter(user=self.request.user)


class UserArticleInteractionViewSet(viewsets.ModelViewSet):
    permission_classes = [IsAuthenticated]
    serializer_class = UserArticleInteractionSerializer

    def get_queryset(self):
        return UserArticleInteraction.objects.filter(user=self.request.user)

    def perform_create(self, serializer):
        serializer.save(user=self.request.user)


class RecommendationView(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request):
        user = request.user
        cache_key = f"user:{user.id}:recommendations"
        data = cache.get(cache_key)

        if data is None:
            #  Compute immediately if not in cache (sync compute)
            data = compute_recommendations_for_user(user.id)

            # or async (may be empty on first call): compute_recommendations_for_user.delay(user.id)
        
        return Response(data)

