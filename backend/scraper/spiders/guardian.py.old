import scrapy
from datetime import datetime

class GuardianSpider(scrapy.Spider):
    name = "guardian"
    allowed_domains = ["theguardian.com"]
    start_urls = ["https://www.theguardian.com/international"]

    def parse(self, response):
        # select article links from the Guardian homepage
        for article in response.css("a.u-faux-block-link__overlay"):
            url = article.attrib.get("href")
            if url:
                yield response.follow(url, callback=self.parse_article)

    def parse_article(self, response):
        title = response.css("h1::text").get()
        summary = response.css("meta[name=description]::attr(content)").get()
        published_str = response.css("time::attr(datetime)").get()
        published_at = None
        if published_str:
            try:
                published_at = datetime.fromisoformat(published_str.replace("Z", "+00:00"))
            except Exception:
                pass

        yield {
            "url": response.url,
            "title": title,
            "summary": summary,
            "content": " ".join(response.css("p::text").getall()),
            "author": ", ".join(response.css(".byline__name::text").getall()),
            "image_url": response.css("meta[property='og:image']::attr(content)").get(),
            "published_at": published_at,
            "categories": response.css("meta[property='article:section']::attr(content)").getall(),
            "source_name": "The Guardian",
        }
